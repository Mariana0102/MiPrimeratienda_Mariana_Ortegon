<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mi tienda</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,600;0,800;0,900;1,400;1,700&display=swap');

    body {
      font-family: 'Montserrat', sans-serif;
      background-color: #0b0f19; /* Fondo oscuro y moderno */
      color: #f3f4f6;
      padding: 30px 20px;
      margin: 0;
      text-align: center;
    }

    h1 {
      color: #ffffff;
      font-weight: 900;
      font-size: 36px;
      letter-spacing: -1px;
      margin-bottom: 6px;
      text-transform: uppercase;
    }

    h1 span {
      color: #00ffcc; /* Toque neón para resaltar el nombre o categoría */
    }

    .slogan {
      color: #9ca3af;
      font-size: 16px;
      font-weight: 600;
      margin-top: 0;
      margin-bottom: 30px;
      letter-spacing: 0.5px;
    }

    /* Beneficios de la tienda */
    .beneficios {
      display: flex;
      justify-content: center;
      gap: 25px;
      flex-wrap: wrap;
      background: linear-gradient(135deg, #1f2937 0%, #111827 100%);
      color: #38bdf8; /* Azul eléctrico brillante */
      border: 1px solid rgba(56, 189, 248, 0.2);
      padding: 16px 20px;
      border-radius: 12px;
      margin: 0 auto 40px auto;
      max-width: 800px;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
    }

    .beneficios span {
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.3px;
    }

    /* Catálogo */
    #productos {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 24px;
      max-width: 1200px;
      margin: 0 auto;
    }

    .producto {
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: #111827; /* Tarjetas oscuras elegantes */
      border-radius: 16px;
      padding: 16px;
      width: 220px;
      text-align: left;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .producto:hover {
      transform: translateY(-8px);
      border-color: #00ffcc;
      box-shadow: 0 20px 35px -5px rgba(0, 255, 204, 0.15);
    }

    .producto img {
      width: 100%;
      height: 160px;
      object-fit: cover;
      border-radius: 10px;
      background-color: #1f2937;
    }

    .producto h3 {
      margin: 14px 0 6px 0;
      color: #ffffff;
      font-size: 16px;
      font-weight: 800;
    }

    .descripcion {
      font-size: 12px;
      color: #9ca3af;
      min-height: 45px;
      line-height: 1.5;
      margin-bottom: 12px;
    }

    .precio {
      font-size: 18px;
      font-weight: 900;
      color: #00ffcc; /* Precio en verde neón destacado */
      margin-bottom: 12px;
    }

    /* Botones de producto */
    .producto button {
      background: linear-gradient(135deg, #00ffcc 0%, #00b4d8 100%);
      border: none;
      color: #0b0f19;
      padding: 11px 14px;
      width: 100%;
      border-radius: 8px;
      font-weight: 800;
      font-size: 13px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .producto button:hover {
      filter: brightness(1.15);
      transform: scale(1.02);
      box-shadow: 0 0 15px rgba(0, 255, 204, 0.4);
    }

    .producto button:active {
      transform: scale(0.98);
    }

    /* Carrito */
    .carrito {
      margin: 50px auto 20px auto;
      padding: 30px;
      background: #111827;
      border-radius: 16px;
      text-align: left;
      display: inline-block;
      width: 100%;
      max-width: 500px;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .carrito h2 {
      margin-top: 0;
      color: #ffffff;
      font-size: 20px;
      font-weight: 800;
      border-bottom: 2px solid #1f2937;
      padding-bottom: 12px;
    }

    #lista-carrito {
      padding-left: 20px;
      margin: 15px 0;
    }

    #lista-carrito li {
      margin-bottom: 10px;
      color: #d1d5db;
      font-size: 14px;
      font-weight: 600;
    }

    .resumen {
      border-top: 1px solid #1f2937;
      margin-top: 20px;
      padding-top: 15px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .resumen p {
      margin: 0;
      color: #9ca3af;
    }

    .total {
      font-size: 20px !important;
      font-weight: 900 !important;
      color: #00ffcc !important;
    }

    /* Contenedor de botones inferiores o acciones de carrito */
    .carrito button {
      padding: 12px 18px;
      border-radius: 8px;
      font-weight: 800;
      font-size: 14px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    /* Botón vaciar */
    .vaciar {
      background-color: transparent;
      border: 1px solid #ef4444;
      color: #fca5a5;
      margin-top: 15px;
      margin-right: 8px;
    }

    .vaciar:hover {
      background-color: #ef4444;
      color: white;
    }

    /* Botón finalizar */
    .finalizar {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      border: none;
      color: white;
      margin-top: 15px;
    }

    .finalizar:hover {
      filter: brightness(1.1);
      box-shadow: 0 0 15px rgba(16, 185, 129, 0.4);
    }
  </style>
</head>
<body>
  <h1>👟 Sole Metrics - Tenis de Entrenamiento</h1>

  <p class="slogan">
    Máximo rendimiento y amortiguación en cada pisada ⚡
  </p>

  <div class="beneficios">
    <span>🚚 Envíos en Bogotá</span>
    <span>🔒 Compra 100% Segura</span>
    <span>📦 Seguimiento de pedido</span>
  </div>

  <div id="productos"></div>

  <div class="carrito">
    <h2>🧾 Carrito de Compras</h2>

    <ul id="lista-carrito"></ul>

    <div class="resumen">
      <p>
        Envío: <strong>Gratis</strong>
      </p>

      <p class="total">
        Total: $<span id="total">0</span>
      </p>
    </div>

    <button class="vaciar" onclick="vaciarCarrito()">
      🧼 Vaciar Carrito
    </button>

    <button class="finalizar" onclick="finalizarCompra()">
      ✅ Finalizar Compra
    </button>
  </div>

  <script>
    const productos = [
      {
        id: 1,
        nombre: "Nike Metcon 10",
        descripcion: "Eleva tu potencial de cross training con los Metcon 10. Optimizan la estabilidad para los levantamientos más pesados con una placa Hyperlift ultrarresistente y aumentan la movilidad con la espuma ReactX Foam responsiva.",
        precio: 865000,
        imagen: "https://static.nike.com/a/images/t_web_pdp_535_v2/f_auto,u_9ddf04c7-2a9a-4d76-add1-d15af8f0263d,c_scale,fl_relative,w_1.0,h_1.0,fl_layer_apply/04d8ba5b-5918-4316-807b-7b37849c9af9/W+NIKE+METCON+10.png"
      },
      {
        id: 2,
        nombre: "Nike Free Metcon 7",
        descripcion: " tenis de entrenamiento más versátiles se actualizan con una mejor contención en el mediopié. El antepié flexible y el talón estable te permiten pasar fácilmente de movimientos dinámicos a ejercicios de fuerza.",
        precio: 715000,
        imagen: "https://static.nike.com/a/images/t_web_pdp_535_v2/f_auto,u_9ddf04c7-2a9a-4d76-add1-d15af8f0263d,c_scale,fl_relative,w_1.0,h_1.0,fl_layer_apply/3594a766-cbd7-4e37-b363-26d27fc0d9f7/W+NIKE+FREE+METCON+7.png"
      },
      {
        id: 3,
        nombre: "Nike Hybrid RN",
        descripcion: "Diseñados para atletas que combinan carrera y levantamiento de peso, los Hybrid RN te acompañan de los sprints a las sentadillas sin perder el impulso.",
        precio: 800000,
        imagen: "https://static.nike.com/a/images/t_web_pdp_535_v2/f_auto,u_9ddf04c7-2a9a-4d76-add1-d15af8f0263d,c_scale,fl_relative,w_1.0,h_1.0,fl_layer_apply/ced4fc39-f39c-4e43-a9bd-3e1c0d70754e/W+NIKE+HYBRID+RN.png"
      },
      {
        id: 4,
        nombre: "Nike Motiva 2",
        descripcion: "Pensados para tus caminatas diarias, vuelven con un diseño más ligero y estilizado. La espuma tipo nube en la entresuela mantiene la misma sensación bajo el pie que el modelo original, y la malla en capas en la parte superior garantiza frescura y tarnspirabilidad en cada paso.",
        precio: 660000,
        imagen: "https://static.nike.com/a/images/t_web_pdp_535_v2/f_auto,u_9ddf04c7-2a9a-4d76-add1-d15af8f0263d,c_scale,fl_relative,w_1.0,h_1.0,fl_layer_apply/a77564ab-cf45-44d6-80a7-b17cae488e78/WMNS+NIKE+MOTIVA+2.png"
      },
      {
        id: 5,
        nombre: "Nike Mind 002",
        descripcion: "La amortiguación de la espuma suave y responsiva junto con el talón y la plantilla moldeados ofrecen comodidad adondequiera que vayas. En la parte superior, las agujetas acercan los pies a los nodos para acentuar la sensación.",
        precio: 765000,
        imagen: "https://static.nike.com/a/images/t_web_pdp_535_v2/f_auto,u_9ddf04c7-2a9a-4d76-add1-d15af8f0263d,c_scale,fl_relative,w_1.0,h_1.0,fl_layer_apply/21448725-5eed-4267-91f9-81333475bc80/W+NIKE+MIND+002.png"
      }
    ];


    /* ==============================
       CARRITO
    ================================ */

    const carrito = [];

    const contenedorProductos = document.getElementById("productos");
    const listaCarrito = document.getElementById("lista-carrito");
    const totalCarrito = document.getElementById("total");


    /* ==============================
       MOSTRAR PRODUCTOS
    ================================ */

    function mostrarProductos() {

      contenedorProductos.innerHTML = "";

      productos.forEach(prod => {

        const div = document.createElement("div");

        div.className = "producto";

        div.innerHTML = `
          <img src="${prod.imagen}" alt="${prod.nombre}">

          <h3>${prod.nombre}</h3>

          <p class="descripcion">
            ${prod.descripcion}
          </p>

          <p class="precio">
            ${prod.precio.toLocaleString("es-CO", {
              style: "currency",
              currency: "COP",
              minimumFractionDigits: 0
            })}
          </p>

          <button onclick="agregarAlCarrito(${prod.id})">
            Agregar al carrito
          </button>
        `;

        contenedorProductos.appendChild(div);

      });

    }


    /* ==============================
       AGREGAR AL CARRITO
    ================================ */

    function agregarAlCarrito(id) {

      const productoExistente =
        carrito.find(p => p.id === id);

      if (productoExistente) {

        productoExistente.cantidad++;

      } else {

        const producto =
          productos.find(p => p.id === id);

        carrito.push({
          ...producto,
          cantidad: 1
        });

      }

      actualizarCarrito();

    }


    /* ==============================
       ACTUALIZAR CARRITO
    ================================ */

    function actualizarCarrito() {

      listaCarrito.innerHTML = "";

      let total = 0;
      let totalItems = 0;

      carrito.forEach(item => {

        const li =
          document.createElement("li");

        const subtotal =
          item.precio * item.cantidad;

        li.textContent =
          `${item.nombre} x${item.cantidad} — ` +
          subtotal.toLocaleString("es-CO", {
            style: "currency",
            currency: "COP",
            minimumFractionDigits: 0
          });

        listaCarrito.appendChild(li);

        total += subtotal;
        totalItems += item.cantidad;

      });

      totalCarrito.textContent =
        total.toLocaleString("es-CO");

      actualizarTituloCarrito(totalItems);

    }


    /* ==============================
       CONTADOR DEL CARRITO
    ================================ */

    function actualizarTituloCarrito(cantidad) {

      const titulo =
        document.querySelector(".carrito h2");

      titulo.textContent =
        `🧾 Carrito de Compras (${cantidad})`;

    }


    /* ==============================
       VACIAR CARRITO
    ================================ */

    function vaciarCarrito() {

      if (carrito.length === 0) {

        alert("🛒 El carrito ya está vacío.");

        return;

      }

      if (
        confirm(
          "¿Estás seguro de que quieres vaciar el carrito?"
        )
      ) {

        carrito.length = 0;

        actualizarCarrito();

      }

    }


    /* ==============================
       FINALIZAR COMPRA
    ================================ */

    function finalizarCompra() {

      if (carrito.length === 0) {

        alert(
          "🛒 Tu carrito está vacío. Agrega productos antes de finalizar la compra."
        );

        return;

      }

      alert(
        "🎉 ¡Pedido simulado confirmado!\n\n" +
        "En un eCommerce real, ahora entrarían en acción " +
        "el backend, la pasarela de pago y la logística."
      );

      carrito.length = 0;

      actualizarCarrito();

    }


    /* ==============================
       INICIAR TIENDA
    ================================ */

    mostrarProductos();
  </script>
</body>
</html>
